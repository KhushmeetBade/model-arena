# Required for racing: free key from https://openrouter.ai/settings/keys
# Only OpenRouter ":free" models are used — they cost $0.
OPENROUTER_API_KEY=

# Optional official APIs. These BILL your account per token and stay disabled
# until you enable "Paid providers" in Settings (or set ALLOW_PAID_PROVIDERS=true).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ALLOW_PAID_PROVIDERS=false

# Optional
PORT=8787
